{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "drive_bulletins_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_bulletins": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncDriveBulletins",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05e2\u05dc\u05d5\u05e0\u05d9\u05dd \u05de\u05d4-Drive",
            "description": "\u05e2\u05d9\u05d1\u05d5\u05d3 \u05e7\u05d5\u05d1\u05e6\u05d9 PDF \u05d7\u05d3\u05e9\u05d9\u05dd \u05d1\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05e2\u05dc\u05d5\u05e0\u05d9\u05dd"
          }
        }
      }
    ]
  },
  "name": "Drive Bulletins Sync",
  "description": "\u05d9\u05e6\u05d9\u05e8\u05ea \u05e2\u05dc\u05d5\u05df \u05d7\u05d3\u05e9 \u05d1\u05d0\u05ea\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05db\u05e9\u05de\u05d5\u05e1\u05d9\u05e4\u05d9\u05dd \u05e7\u05d5\u05d1\u05e5 PDF \u05dc\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05e2\u05dc\u05d5\u05e0\u05d9\u05dd \u05d1-Google Drive",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "connector",
      "events": [
        "changes"
      ],
      "integration_type": "googledrive",
      "resource_id": null
    }
  }
}